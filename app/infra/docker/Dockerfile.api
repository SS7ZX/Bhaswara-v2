FROM node:22-bookworm-slim

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages

RUN npm ci \
  && DATABASE_URL=postgresql://build:build@localhost:5432/build npm --workspace @bhaswara/api run db:generate \
  && npm prune --omit=dev

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "--workspace", "@bhaswara/api", "run", "start"]
